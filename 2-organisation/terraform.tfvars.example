# Copy this file to terraform.tfvars and fill in your real values.
# terraform.tfvars is gitignored — it never gets committed.

region                      = "eu-west-2"
management_account_id       = "YOUR_MANAGEMENT_ACCOUNT_ID"
shared_services_account_id  = "YOUR_SHARED_SERVICES_ACCOUNT_ID"
github_org                  = "coolteddy"
github_repo                 = "aws-org-infra"
github_shared_services_repo = "aws-shared-services-infra"
github_sandbox_repo         = "aws-sandbox-infra"

# Unique email for the sandbox account — use a Gmail alias
# e.g. you+aws-sandbox@gmail.com (routes to your main inbox, unique to AWS)
sandbox_email = "you+aws-sandbox@gmail.com"

tags = {
  Project     = "aws-org-infra"
  ManagedBy   = "terraform"
  Environment = "management"
}
